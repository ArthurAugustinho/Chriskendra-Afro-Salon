---
import { business, ratingLine, site, ui } from "../lib/site";
import Icon from "./Icon.astro";

const source = ui.reviewsSource.replace("{count}", String(business.googleRating.count));
---

<section class="section reviews" aria-labelledby="reviews-title">
  <div class="wrap reviews__inner">
    <div class="reviews__head">
      <h2 id="reviews-title">{ui.reviewsTitle}</h2>
      <p class="reviews__score">
        <Icon name="star" />
        {ratingLine}
      </p>
      <p>
        <a href={business.googleMapsUrl}>{source}</a>
      </p>
    </div>
    <ul class="themes">
      {site.reviewThemes.map((theme) => (
        <li>
          <h3>{theme.title}</h3>
          <p>{theme.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .reviews__inner {
    display: grid;
    gap: 28px;
  }

  .reviews__head {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .reviews__head a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .reviews__score {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .reviews__score :global(svg) {
    flex: none;
    width: 24px;
    height: 24px;
    color: var(--magenta);
  }

  .themes {
    list-style: none;
    padding: 0;
  }

  .themes li {
    display: grid;
    gap: 6px;
    padding-block: 20px;
    border-top: 1px solid rgb(59 33 23 / 0.25);
  }

  .themes li:last-child {
    border-bottom: 1px solid rgb(59 33 23 / 0.25);
  }

  .themes h3 {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 400;
  }

  @media (min-width: 900px) {
    .reviews__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 56px;
    }
  }
</style>
