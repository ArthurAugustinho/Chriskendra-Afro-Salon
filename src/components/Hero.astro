---
import { Picture } from "astro:assets";
import {
  bookingUrl,
  business,
  copy,
  phoneText,
  photoByFile,
  ratingLine,
  telUrl,
  ui,
} from "../lib/site";
import closeup from "../assets/hero/two-strand-twists-in-salon-closeup.jpg";
import Icon from "./Icon.astro";

// The salon's own photo leads, cropped to the head (scripts/crop-hero.mjs).
const salon = photoByFile("photos/two-strand-twists-in-salon.jpg");
const shots = [
  { photo: { ...salon, src: closeup }, crop: "crop-center" },
  { photo: photoByFile("photos/cornrow-updo.jpg"), crop: "crop-mid" },
  { photo: photoByFile("photos/triangle-part-knotless-braids.jpg"), crop: "crop-mid" },
];
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="wrap hero__inner">
    <div class="hero__text">
      <h1 id="hero-title">{copy.headline}</h1>
      <p class="hero__intro">{copy.intro}</p>
      <p class="hero__rating">
        <Icon name="star" />
        <a href={business.googleMapsUrl}>{ratingLine}</a>
      </p>
      <div class="hero__actions">
        <a class="btn btn--gold" href={bookingUrl}>
          <Icon name="whatsapp" />
          {ui.bookButton}
        </a>
        <a class="btn btn--line-light" href={telUrl}>
          <Icon name="phone" />
          {ui.callButton}
          {phoneText}
        </a>
      </div>
    </div>

    <div class="parting-grid hero__grid">
      {shots.map(({ photo, crop }, i) => (
        <div class:list={["hero__cell", `hero__cell--${i + 1}`]}>
          <Picture
            src={photo.src}
            alt={photo.alt}
            formats={["avif", "webp"]}
            widths={i === 0 ? [320, 480, 620] : [240, 360, 540]}
            sizes={
              i === 0
                ? "(min-width: 1224px) 330px, (min-width: 900px) 27vw, calc(52vw - 18px)"
                : "(min-width: 1224px) 300px, (min-width: 900px) 25vw, calc(48vw - 16px)"
            }
            class={crop}
            priority={i === 0}
            loading="eager"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 20px 48px;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
  }

  .hero__text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .hero__intro {
    max-width: 34em;
    color: var(--blush);
  }

  .hero__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }

  .hero__rating a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .hero__rating :global(svg) {
    flex: none;
    width: 22px;
    height: 22px;
    color: var(--gold);
  }

  .hero__actions {
    display: grid;
    gap: 12px;
    width: 100%;
  }

  .hero__grid {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    aspect-ratio: 1 / 1.05;
  }

  .hero__cell--1 {
    grid-row: 1 / 3;
  }

  .crop-center {
    object-position: 45% 50%;
  }

  .crop-mid {
    object-position: 50% 55%;
  }

  /* Phones: photos come before the buttons so they make the first screen; the fixed
     WhatsApp/Call bar already keeps the booking action in view. DOM order is unchanged. */
  @media (max-width: 899.98px) {
    .hero__inner {
      gap: 20px;
      justify-items: start;
    }

    .hero__text {
      display: contents;
    }

    .hero__grid {
      order: 1;
      justify-self: stretch;
    }

    .hero__actions {
      order: 2;
      padding-top: 4px;
    }
  }

  @media (min-width: 600px) {
    .hero__actions {
      grid-auto-flow: column;
      justify-content: start;
    }
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: 40px 88px;
    }

    .hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      gap: 56px;
    }

    .hero__text {
      gap: 24px;
    }

    .hero__grid {
      aspect-ratio: 1 / 0.95;
    }
  }
</style>
